    "@nuxt/fonts": "^0.13.0",
    "@nuxt/image": "^2.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "^14.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.3.0",
    "lucide-vue-next": "^0.563.0",
    "nexus-req": "^3.1.7",
    "nuxt": "^4.3.0",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
