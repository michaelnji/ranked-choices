    "eslint-plugin-format": "^1.3.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.6.1",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
